# Copy to a private environment file and replace every placeholder.
# Never commit real production secrets.
ROCKSOUL_API_KEY=replace-with-a-unique-high-entropy-api-key
ROCKSOUL_CONSOLE_ADMIN_PASSWORD=replace-with-a-strong-admin-password
ROCKSOUL_CONSOLE_OPERATOR_PASSWORD=replace-with-a-strong-operator-password
ROCKSOUL_CONSOLE_SESSION_SECRET=replace-with-at-least-32-random-characters
ROCKSOUL_CONSOLE_ADMIN_ID=stable-admin-principal-id
ROCKSOUL_CONSOLE_OPERATOR_ID=stable-operator-principal-id
ROCKSOUL_APPROVAL_SIGNING_SECRET=replace-with-a-different-32-plus-character-random-secret
ROCKSOUL_CONSOLE_PORT=3000
